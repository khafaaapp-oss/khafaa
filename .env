# ── Server ──────────────────────────────────────
PORT=8000
NODE_ENV=development

# ── MongoDB ─────────────────────────────────────
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/chat_app?retryWrites=true&w=majority

# ── JWT ─────────────────────────────────────────
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# ── Admin ───────────────────────────────────────
# An 11-digit number. Any user signing up with this
# number becomes admin automatically.
ADMIN_PHONE_NUMBER=00000000000

# ── CORS ────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000
